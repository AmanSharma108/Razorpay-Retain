# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Public Tunnel URL for Webhooks (e.g., from `ngrok http 8000`)
PUBLIC_WEBHOOK_URL=https://your-ngrok-subdomain.ngrok-free.app

# Database & Frontend
DATABASE_URL=sqlite+aiosqlite:///./revenue_recovery.db
FRONTEND_URL=http://localhost:5173

# Polling & Fallback Configuration
ABANDONMENT_CHECK_INTERVAL_MINUTES=1
ABANDONMENT_THRESHOLD_MINUTES=1
POLLING_INTERVAL_SECONDS=20
