# =================================================================
# Razorpay Retain - Production Configuration Template
# =================================================================

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
ENABLE_DOCS=false

# Razorpay Gateway API Credentials (from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET

# Webhook Secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=YOUR_PRODUCTION_WEBHOOK_SECRET

# Public Webhook Domain or Load Balancer URL
PUBLIC_WEBHOOK_URL=https://api.yourdomain.com

# Database Connection (PostgreSQL recommended for high-volume production)
# Example Postgres: postgresql+asyncpg://user:password@localhost:5432/razorpay_retain
# Example SQLite: sqlite+aiosqlite:///./revenue_recovery.db
DATABASE_URL=postgresql+asyncpg://retain_user:strong_password@postgres:5432/retain_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# CORS Allowed Origins (Comma-separated list of production frontend domains)
CORS_ORIGINS=https://retain.yourdomain.com,https://app.yourdomain.com

# Rate Limiting & Protection
RATE_LIMIT_PER_MINUTE=180

# Background Workers & Thresholds
POLLING_INTERVAL_SECONDS=30
ABANDONMENT_THRESHOLD_MINUTES=30
ABANDONMENT_CHECK_INTERVAL_MINUTES=5
HEALTH_CHECK_TIMEOUT_SECONDS=5
